{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>blackdark/renovate-base//default.json5",
    "github>blackdark/renovate-base//go.json5",
  ],
  rebaseWhen: "behind-base-branch",
  separateMultipleMajor: true,
  postUpdateOptions: ["gomodTidy", "gomodUpdateImportPaths"],
  packageRules: [
    {
      groupName: "kubernetes dependencies",
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: ["k8s.io/{/,}**", "sigs.k8s.io/{/,}**"],
    },
    {
      groupName: "cert-manager",
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: ["github.com/cert-manager/{/,}**"],
    },
    {
      groupName: "opentelemetry",
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: ["go.opentelemetry.io/{/,}**"],
    },
    {
      description: "Majors: one PR each, merged by hand",
      matchUpdateTypes: ["major"],
      addLabels: ["major"],
      automerge: false,
    },
  ],
}
