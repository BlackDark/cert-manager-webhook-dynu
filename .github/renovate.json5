{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
  ],
  labels: [
    'dependencies',
  ],
  schedule: [
    'before 6am on monday',
  ],
  packageRules: [
    {
      matchUpdateTypes: [
        'minor',
        'patch',
        'pin',
        'digest',
        'lockFileMaintenance',
      ],
      automerge: true,
    },
    {
      groupName: 'go modules (non-major)',
      matchManagers: [
        'gomod',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
    },
    {
      groupName: 'github actions',
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
    },
    {
      groupName: 'docker base images',
      matchManagers: [
        'dockerfile',
      ],
    },
    {
      groupName: 'kubernetes dependencies',
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      matchPackageNames: [
        'k8s.io/{/,}**',
        'sigs.k8s.io/{/,}**',
      ],
    },
    {
      groupName: 'cert-manager',
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      matchPackageNames: [
        'github.com/cert-manager/{/,}**',
      ],
    },
    {
      groupName: 'opentelemetry',
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      matchPackageNames: [
        'go.opentelemetry.io/{/,}**',
      ],
    },
  ],
}
